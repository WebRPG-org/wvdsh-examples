settings = {
    orientation = {
        default   = "landscapeRight",
        supported = { "landscapeRight", "landscapeLeft" },
    },
    -- Keep the exported build/ folder (and docs) out of the packaged app;
    -- otherwise each HTML5 build re-packs the previous one.
    excludeFiles = {
        all = { "build/*", "*.md", "wavedash.toml" },
    },
    -- HTML5 has no other build-specific settings here. The SDK is wired in via
    -- Solar2D's JavaScript Module Loader — see wavedash.js at the project
    -- root and the `require "wavedash"` call in main.lua.
}
